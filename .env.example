# Firebase Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control

# Development Environment
FIREBASE_API_KEY=your_dev_api_key_here
FIREBASE_APP_ID=your_dev_app_id_here
FIREBASE_MESSAGING_SENDER_ID=your_dev_sender_id_here
FIREBASE_PROJECT_ID=your_dev_project_id_here
FIREBASE_STORAGE_BUCKET=your_dev_storage_bucket_here

# Production Environment (when ready)
FIREBASE_API_KEY_PROD=your_prod_api_key_here
FIREBASE_APP_ID_PROD=your_prod_app_id_here
FIREBASE_MESSAGING_SENDER_ID_PROD=your_prod_sender_id_here
FIREBASE_PROJECT_ID_PROD=your_prod_project_id_here
FIREBASE_STORAGE_BUCKET_PROD=your_prod_storage_bucket_here

# Environment Selection (development or production)
ENVIRONMENT=development

# Optional: Other API Keys
# GOOGLE_MAPS_API_KEY=your_google_maps_key_here
# SENTRY_DSN=your_sentry_dsn_here
