# Copy to .env.development / .env.production — committed as documentation only.
# Replaces lib/config/environment.dart's hardcoded Environment.current constant.
# Unlike the Flutter app (which bundles BOTH dev and prod Firebase credentials into
# every build), react-native-config + build flavors/schemes ensure only the active
# environment's credentials are compiled into a given build.

ENVIRONMENT=development
FIREBASE_PROJECT_ID=podsafe-92a3e
PUBLIC_POD_BASE_URL=http://localhost:5000
ENABLE_CRASHLYTICS=false
SHOW_ENVIRONMENT_BANNER=true
