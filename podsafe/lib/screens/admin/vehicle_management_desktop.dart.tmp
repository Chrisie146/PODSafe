          ),
          Expanded(
            child: Text(
              value,
              style: const TextStyle(
                fontSize: 12,
                fontWeight: FontWeight.w600,
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildVehiclesTable(List<Vehicle> vehicles) {
    if (vehicles.isEmpty) {
      return Container(
        padding: const EdgeInsets.symmetric(vertical: 48),
        decoration: BoxDecoration(
          color: Colors.white,
          borderRadius: BorderRadius.circular(12),
          border: Border.all(color: Colors.grey[200]!),
        ),
        child: Center(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Icon(Icons.directions_car_outlined,
                  size: 64, color: Colors.grey[300]),
              const SizedBox(height: 16),
              Text(
                'No vehicles found',
                style: TextStyle(
                  fontSize: 18,
                  fontWeight: FontWeight.bold,
                  color: Colors.grey[600],
                ),
              ),
              const SizedBox(height: 8),
              Text(
                _searchQuery.isNotEmpty
                    ? 'Try adjusting your search'
                    : 'Add your first vehicle to get started',
                style: TextStyle(color: Colors.grey[500]),
              ),
            ],
          ),
        ),
      );
    }

    return Container(
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: Colors.grey[200]!),
      ),
      child: SingleChildScrollView(
        scrollDirection: Axis.horizontal,
        child: SingleChildScrollView(
          child: DataTable(
            headingRowColor: WidgetStateProperty.all(Colors.grey[100]),
            columnSpacing: 16,
            horizontalMargin: 12,
            columns: [
              if (_isMultiSelectMode)
                DataColumn(
                  label: Checkbox(
                    value: _selectedVehicleIds.length == vehicles.length && vehicles.isNotEmpty,
                    onChanged: (value) {
                      setState(() {
                        if (value == true) {
                          _selectedVehicleIds = vehicles.map((v) => v.id).toSet();
                        } else {
                          _selectedVehicleIds.clear();
                        }
                      });
                    },
                  ),
                ),
              DataColumn(
                label: _buildSortableHeader('Registration', 'registration'),
              ),
              DataColumn(
                label: _buildSortableHeader('Make / Model', 'make'),
              ),
              const DataColumn(label: Text('Plate')),
              DataColumn(
                label: _buildSortableHeader('Status', 'status'),
              ),
              DataColumn(
                label: _buildSortableHeader('Deliveries', 'deliveries'),
              ),
              DataColumn(
                label: _buildSortableHeader('Last Used', 'lastUsed'),
              ),
              const DataColumn(label: Text('Actions')),
            ],
            rows: vehicles.map((vehicle) {
              final isSelected = _selectedVehicleIds.contains(vehicle.id);
              return DataRow(
                selected: isSelected,
                onSelectChanged: _isMultiSelectMode
                    ? (selected) {
                        setState(() {
                          if (selected == true) {
                            _selectedVehicleIds.add(vehicle.id);
                          } else {
                            _selectedVehicleIds.remove(vehicle.id);
                          }
                        });
                      }
                    : (selected) {
                        if (selected == true) {
                          setState(() => _selectedVehicle = vehicle);
                        }
                      },
                cells: [
                  if (_isMultiSelectMode)
                    DataCell(
                      Checkbox(
                        value: isSelected,
                        onChanged: (value) {
                          setState(() {
                            if (value == true) {
                              _selectedVehicleIds.add(vehicle.id);
                            } else {
                              _selectedVehicleIds.remove(vehicle.id);
                            }
                          });
                        },
                      ),
                    ),
                  // Registration
                  DataCell(
                    Text(
                      vehicle.registration,
                      style: const TextStyle(
                        fontWeight: FontWeight.w600,
                        fontSize: 13,
                      ),
                    ),
                  ),

                  // Make / Model
                  DataCell(
                    Text(
                      '${vehicle.make ?? '-'} ${vehicle.model ?? '-'}'.trim(),
                      style: const TextStyle(fontSize: 13),
                    ),
                  ),

                  // Plate
                  DataCell(
                    Text(
                      vehicle.licensePlate ?? '-',
                      style: const TextStyle(fontSize: 13),
                    ),
                  ),

                  // Status
                  DataCell(
                    Container(
                      padding: const EdgeInsets.symmetric(
                          horizontal: 10, vertical: 6),
                      decoration: BoxDecoration(
                        color: _getStatusColor(vehicle.status)
                            .withOpacity(0.15),
                        borderRadius: BorderRadius.circular(6),
                      ),
                      child: Row(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          Icon(
                            _getStatusIcon(vehicle.status),
                            size: 16,
                            color: _getStatusColor(vehicle.status),
                          ),
                          const SizedBox(width: 6),
                          Text(
                            _getStatusLabel(vehicle.status),
                            style: TextStyle(
                              fontSize: 12,
                              fontWeight: FontWeight.w600,
                              color: _getStatusColor(vehicle.status),
                            ),
                          ),
                        ],
                      ),
                    ),
                  ),

                  // Deliveries
                  DataCell(
                    Text(
                      vehicle.totalDeliveries.toString(),
                      style: const TextStyle(
                        fontSize: 13,
                        fontWeight: FontWeight.w500,
                      ),
                    ),
                  ),

                  // Last Used
                  DataCell(
                    Tooltip(
                      message: vehicle.lastUsedAt != null
                          ? DateFormat('MMM d, yyyy h:mm a')
                              .format(vehicle.lastUsedAt!)
                          : 'Never used',
                      child: Text(
                        vehicle.lastUsedAt != null
                            ? _getRelativeTime(vehicle.lastUsedAt!)
                            : 'Never',
                        style: TextStyle(
                          fontSize: 13,
                          color: Colors.grey[600],
                        ),
                      ),
                    ),
                  ),

                  // Actions
                  DataCell(
                    PopupMenuButton<String>(
                      icon: const Icon(Icons.more_vert, size: 20),
                      tooltip: 'More Options',
                      itemBuilder: (context) => [
                        const PopupMenuItem(
                          value: 'view',
                          child: Row(
                            children: [
                              Icon(Icons.visibility, size: 18),
                              SizedBox(width: 8),
                              Text('View Details'),
                            ],
                          ),
                        ),
                        const PopupMenuItem(
                          value: 'edit',
                          child: Row(
                            children: [
                              Icon(Icons.edit, size: 18),
                              SizedBox(width: 8),
                              Text('Edit'),
                            ],
                          ),
                        ),
                        if (vehicle.status == VehicleStatus.active)
                          const PopupMenuItem(
                            value: 'maintenance',
                            child: Row(
                              children: [
                                Icon(Icons.construction, size: 18),
                                SizedBox(width: 8),
                                Text('Send to Maintenance'),
                              ],
                            ),
                          ),
                        if (vehicle.status == VehicleStatus.maintenance)
                          const PopupMenuItem(
                            value: 'activate',
                            child: Row(
                              children: [
                                Icon(Icons.check_circle, size: 18),
                                SizedBox(width: 8),
                                Text('Activate'),
                              ],
                            ),
                          ),
                        const PopupMenuDivider(),
                        const PopupMenuItem(
                          value: 'delete',
                          child: Row(
                            children: [
                              Icon(Icons.delete, size: 18, color: Colors.red),
                              SizedBox(width: 8),
                              Text('Delete',
                                  style: TextStyle(color: Colors.red)),
                            ],
                          ),
                        ),
                      ],
                      onSelected: (value) {
                        _handleAction(value, vehicle);
                      },
                    ),
                  ),
                ],
              );
            }).toList(),
          ),
        ),
      ),
    );
  }

  Widget _buildSortableHeader(String label, String sortBy) {
    final isActive = _sortBy == sortBy;
    return InkWell(
      onTap: () {
        setState(() {
          if (_sortBy == sortBy) {
            _sortAscending = !_sortAscending;
          } else {
            _sortBy = sortBy;
            _sortAscending = true;
          }
        });
      },
      child: Row(
        children: [
          Text(
            label,
            style: TextStyle(
              fontWeight: isActive ? FontWeight.bold : FontWeight.w600,
              fontSize: 12,
              color: isActive ? AppTheme.primaryColor : Colors.grey[700],
            ),
          ),
          if (isActive)
            Padding(
              padding: const EdgeInsets.only(left: 4),
              child: Icon(
                _sortAscending
                    ? Icons.arrow_upward
                    : Icons.arrow_downward,
                size: 14,
                color: AppTheme.primaryColor,
              ),
            ),
        ],
      ),
    );
  }

  void _handleAction(String action, Vehicle vehicle) {
    switch (action) {
      case 'view':
        setState(() => _selectedVehicle = vehicle);
        break;
      case 'edit':
        _showEditVehicleDialog(vehicle);
        break;
      case 'maintenance':
        _updateVehicleStatus(vehicle, VehicleStatus.maintenance);
        break;
      case 'activate':
        _updateVehicleStatus(vehicle, VehicleStatus.active);
        break;
      case 'delete':
        _showDeleteConfirmation(vehicle);
        break;
    }
  }

  void _updateVehicleStatus(Vehicle vehicle, VehicleStatus newStatus) async {
    try {
      final authProvider = context.read<AuthProvider>();
      final companyId = authProvider.currentUser?.companyId;
      if (companyId == null) throw Exception('No company ID');

      await FirebaseFirestore.instance
          .collection('companies')
          .doc(companyId)
          .collection('vehicles')
          .doc(vehicle.id)
          .update({'status': newStatus.toString().split('.').last});

      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(
                '${vehicle.registration} status updated to ${_getStatusLabel(newStatus)}'),
            backgroundColor: Colors.green,
          ),
        );
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Error updating status: $e'),
            backgroundColor: AppTheme.errorColor,
          ),
        );
      }
    }
  }

  void _showDeleteConfirmation(Vehicle vehicle) {
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Delete Vehicle'),
        content: Text(
            'Are you sure you want to delete ${vehicle.registration}? This cannot be undone.'),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('Cancel'),
          ),
          ElevatedButton(
            onPressed: () {
              Navigator.pop(context);
              _deleteVehicle(vehicle);
            },
            style: ElevatedButton.styleFrom(
              backgroundColor: AppTheme.errorColor,
            ),
            child: const Text('Delete'),
          ),
        ],
      ),
    );
  }

  void _deleteVehicle(Vehicle vehicle) async {
    try {
      final authProvider = context.read<AuthProvider>();
      final companyId = authProvider.currentUser?.companyId;
      if (companyId == null) throw Exception('No company ID');

      await FirebaseFirestore.instance
          .collection('companies')
          .doc(companyId)
          .collection('vehicles')
          .doc(vehicle.id)
          .delete();

      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('${vehicle.registration} deleted'),
            backgroundColor: Colors.green,
          ),
        );
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Error deleting vehicle: $e'),
            backgroundColor: AppTheme.errorColor,
          ),
        );
      }
    }
  }

  void _exportToCsv() {
    try {
      final authProvider = context.read<AuthProvider>();
      final companyId = authProvider.currentUser?.companyId;
      if (companyId == null) throw Exception('No company ID');

      _vehiclesStream.listen((vehicles) {
        final filteredVehicles = _filterAndSortVehicles(vehicles);
        
        // Build CSV content
        final csvContent = StringBuffer();
        csvContent.writeln('Registration,Make,Model,Plate,Status,Deliveries,Last Used,Created');
        
        for (final vehicle in filteredVehicles) {
          final lastUsed = vehicle.lastUsedAt != null
              ? DateFormat('MMM d, yyyy h:mm a').format(vehicle.lastUsedAt!)
              : 'Never';
          csvContent.writeln(
            '${vehicle.registration},'
            '${vehicle.make ?? ''},${vehicle.model ?? ''},'
            '${vehicle.licensePlate ?? ''},'
            '${_getStatusLabel(vehicle.status)},'
            '${vehicle.totalDeliveries},'
            '$lastUsed,'
            '${DateFormat('MMM d, yyyy').format(vehicle.createdAt)}'
          );
        }

        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('CSV ready: ${filteredVehicles.length} vehicles'),
            backgroundColor: Colors.green,
          ),
        );
      });
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Error exporting: $e'),
            backgroundColor: AppTheme.errorColor,
          ),
        );
      }
    }
  }

  VehicleDocumentService _getDocumentService() {
    return VehicleDocumentService();
  }

  Future<void> _pickFiles() async {
    try {
      // Allow only image types and limit client-side to max 2 images
      final result = await FilePicker.platform.pickFiles(
        allowMultiple: true,
        withData: true, // Keep for consistency, but also try withReadStream
        withReadStream: true,
        type: FileType.custom,
        allowedExtensions: ['png', 'jpg', 'jpeg', 'webp', 'gif'],
      );
      if (result != null && result.files.isNotEmpty) {
        // Filter to image files just in case
        final images = result.files.where((pf) {
          final name = pf.name.toLowerCase();
          return name.endsWith('.png') || name.endsWith('.jpg') || name.endsWith('.jpeg') || name.endsWith('.webp') || name.endsWith('.gif');
        }).toList();

        var toUse = images;
        if (images.length > 2) {
          toUse = images.sublist(0, 2);
          if (mounted) ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Only the first 2 images were selected (max 2).')));
        }

        setState(() {
          _selectedFiles.clear();
          _selectedFiles.addAll(toUse);
          // initialize progress entries
          for (final pf in _selectedFiles) {
            final id = '${pf.name}_${pf.size}';
            _uploadProgress[id] = 0.0;
            _uploadError[id] = null;
            _uploadedUrl[id] = null;
          }
        });
        if (mounted) {
          ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('Selected ${_selectedFiles.length} file(s)')));
        }
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Error picking files: $e')),
        );
      }
    }
  }

  Future<void> _retryUpload(PlatformFile pf, {String? vehicleId}) async {
    final id = '${pf.name}_${pf.size}';
    setState(() {
      _uploadError[id] = null;
      _uploadProgress[id] = 0.0;
    });

    try {
      final authProvider = context.read<AuthProvider>();
      final companyId = authProvider.currentUser?.companyId;
      if (companyId == null) throw Exception('No company ID');

      final docService = _getDocumentService();
      final url = await docService.uploadFile(
        companyId: companyId,
        vehicleId: vehicleId ?? '',
        file: pf,
        onProgress: (p) {
          setState(() {
            _uploadProgress[id] = p;
          });
        },
      );
      setState(() {
        _uploadedUrl[id] = url;
      });
    } catch (e) {
      setState(() {
        _uploadError[id] = e.toString();
      });
    }
  }

  Future<void> _uploadSelectedFiles() async {
    if (_selectedFiles.isEmpty) return;

    setState(() {
      _isUploading = true;
    });

    try {
      final authProvider = context.read<AuthProvider>();
      final companyId = authProvider.currentUser?.companyId;
      if (companyId == null) throw Exception('No company ID');

      final docService = _getDocumentService();
      final uploadedUrls = <String>[];

      for (final pf in _selectedFiles) {
        final id = '${pf.name}_${pf.size}';
        try {
          final url = await docService.uploadFile(
            companyId: companyId,
            vehicleId: 'temp', // Temporary ID for preview uploads
            file: pf,
            onProgress: (p) {
              setState(() {
                _uploadProgress[id] = p;
              });
            },
          );
          uploadedUrls.add(url);
          setState(() {
            _uploadedUrl[id] = url;
          });
        } catch (e) {
          setState(() {
            _uploadError[id] = e.toString();
          });
        }
      }

      if (uploadedUrls.isNotEmpty) {
        if (mounted) {
          ScaffoldMessenger.of(context).showSnackBar(
            SnackBar(content: Text('Successfully uploaded ${uploadedUrls.length} photo(s)')),
          );
        }
        // keep local preview URLs so user sees uploaded images before saving
        setState(() {
          _previewUrls.addAll(uploadedUrls);
        });
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Error uploading photos: $e')),
        );
      }
    } finally {
      if (mounted) {
        setState(() {
          _isUploading = false;
        });
      }
    }
  }

  void _showAddVehicleDialog() {
    final registrationController = TextEditingController();
    final licensePlateController = TextEditingController();
    final makeController = TextEditingController();
    final modelController = TextEditingController();

    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Add New Vehicle'),
        content: SizedBox(
          width: 600,
          height: 600,
          child: SingleChildScrollView(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                TextField(
                  controller: registrationController,
                  decoration: const InputDecoration(
                    labelText: 'Registration Number *',
                    border: OutlineInputBorder(),
                    hintText: 'e.g., V-001',
                  ),
                ),
                const SizedBox(height: 12),
                TextField(
                  controller: licensePlateController,
                  decoration: const InputDecoration(
                    labelText: 'License Plate',
                    border: OutlineInputBorder(),
                    hintText: 'e.g., ABC 123',
                  ),
                ),
                const SizedBox(height: 12),
                TextField(
                  controller: makeController,
                  decoration: const InputDecoration(
                    labelText: 'Make',
                    border: OutlineInputBorder(),
                    hintText: 'e.g., Toyota',
                  ),
                ),
                const SizedBox(height: 12),
                TextField(
                  controller: modelController,
                  decoration: const InputDecoration(
                    labelText: 'Model',
                    border: OutlineInputBorder(),
                    hintText: 'e.g., Hiace',
                  ),
                ),
                const SizedBox(height: 16),
                // Photos picker (limit to 2 images)
                Text(
                  'Vehicle Photos (Optional, max 2)',
                  style: TextStyle(fontWeight: FontWeight.bold),
                ),
                const SizedBox(height: 8),
                Row(
                  children: [
                    ElevatedButton.icon(
                      onPressed: _pickFiles,
                      icon: const Icon(Icons.photo),
                      label: Text(_selectedFiles.isEmpty ? 'Add Photos' : 'Change Photos'),
                    ),
                    const SizedBox(width: 12),
                    if (_selectedFiles.isNotEmpty) ...[
                        ElevatedButton.icon(
                          onPressed: _isUploading ? null : _uploadSelectedFiles,
                          icon: _isUploading
                              ? const SizedBox(
                                  width: 16,
                                  height: 16,
                                  child: CircularProgressIndicator(strokeWidth: 2, color: Colors.white),
                                )
                              : const Icon(Icons.upload),
                          label: _isUploading ? const Text('Uploading...') : const Text('Upload Photos'),
                          style: ElevatedButton.styleFrom(
                            backgroundColor: Colors.blue,
                          ),
                        ),
                      const SizedBox(width: 12),
                    ],
                    if (_selectedFiles.isNotEmpty)
                      Text('${_selectedFiles.length}/2 selected')
                  ],
                ),
                const SizedBox(height: 8),
                if (_selectedFiles.isNotEmpty)
                  Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      SizedBox(
                        height: 120,
                        child: ListView(
                          scrollDirection: Axis.horizontal,
                          children: _selectedFiles.map((pf) {
                            final isImage = pf.name.toLowerCase().endsWith('.png') || pf.name.toLowerCase().endsWith('.jpg') || pf.name.toLowerCase().endsWith('.jpeg') || pf.name.toLowerCase().endsWith('.webp') || pf.name.toLowerCase().endsWith('.gif');
                            return Padding(
                              padding: const EdgeInsets.only(right: 8.0),
                              child: Stack(
                                children: [
                                  Container(
                                    width: 120,
                                    height: 120,
                                    decoration: BoxDecoration(
                                      border: Border.all(color: Colors.grey.shade300),
                                      borderRadius: BorderRadius.circular(6),
                                    ),
                                    child: ClipRRect(
                                      borderRadius: BorderRadius.circular(6),
                                      child: isImage
                                          ? (pf.bytes != null
                                              ? Image.memory(pf.bytes!, fit: BoxFit.cover)
                                              : (pf.path != null ? Image.file(File(pf.path!), fit: BoxFit.cover) : const SizedBox.shrink()))
                                          : Center(child: Text(pf.name, textAlign: TextAlign.center, overflow: TextOverflow.ellipsis)),
                                    ),
                                  ),
                                  Positioned(
                                    right: 0,
                                    top: 0,
                                    child: InkWell(
                                      onTap: () {
                                        setState(() {
                                          _selectedFiles.remove(pf);
                                        });
                                      },
                                      child: Container(
                                        decoration: BoxDecoration(color: Colors.black54, borderRadius: BorderRadius.circular(12)),
                                        padding: const EdgeInsets.all(4),
                                        child: const Icon(Icons.close, color: Colors.white, size: 16),
                                      ),
                                    ),
                                  ),
                                ],
                              ),
                            );
                          }).toList(),
                        ),
                      ),
                      const SizedBox(height: 8),
                      // list view of names and per-file status
                      Column(
                        children: _selectedFiles.map((pf) {
                          final id = '${pf.name}_${pf.size}';
                          final prog = _uploadProgress[id] ?? 0.0;
                          final err = _uploadError[id];
                          final url = _uploadedUrl[id];
                          return ListTile(
                            contentPadding: EdgeInsets.zero,
                            title: Text(pf.name),
                            subtitle: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Text('${pf.size} bytes'),
                                const SizedBox(height: 6),
                                if (err != null)
                                  Row(
                                    children: [
                                      Expanded(child: Text('Error: $err', style: TextStyle(color: AppTheme.errorColor))),
                                      TextButton(
                                        onPressed: () => _retryUpload(pf),
                                        child: const Text('Retry'),
                                      ),
                                    ],
                                  ),
                                if (err == null && prog > 0 && prog < 1)
                                  LinearProgressIndicator(value: prog),
                                if (url != null)
                                  Row(
                                    children: [
                                      const Icon(Icons.check_circle, color: Colors.green, size: 16),
                                      const SizedBox(width: 6),
                                      Expanded(child: Text(url, maxLines: 1, overflow: TextOverflow.ellipsis)),
                                    ],
                                  ),
                              ],
                            ),
                            trailing: IconButton(
                              icon: const Icon(Icons.delete_outline),
                              onPressed: () {
                                setState(() {
                                  _selectedFiles.remove(pf);
                                });
                              },
                            ),
                          );
                        }).toList(),
                      ),
                    ],
                  ),
                // Show uploaded previews (download URLs) after upload
                if (_previewUrls.isNotEmpty)
                  Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      const SizedBox(height: 12),
                      const Text('Uploaded Photos:', style: TextStyle(fontWeight: FontWeight.w600)),
                      const SizedBox(height: 8),
                      SizedBox(
                        height: 120,
                        child: ListView(
                          scrollDirection: Axis.horizontal,
                          children: _previewUrls.map((url) {
                            return Padding(
                              padding: const EdgeInsets.only(right: 8.0),
                              child: Container(
                                width: 120,
                                height: 120,
                                decoration: BoxDecoration(
                                  border: Border.all(color: Colors.grey.shade300),
                                  borderRadius: BorderRadius.circular(6),
                                ),
                                child: ClipRRect(
                                  borderRadius: BorderRadius.circular(6),
                                  child: CachedNetworkImage(
                                    imageUrl: url,
                                    fit: BoxFit.cover,
                                    placeholder: (context, url) => const Center(child: CircularProgressIndicator()),
                                    errorWidget: (context, url, error) => const Center(child: Icon(Icons.broken_image)),
                                  ),
                                ),
                              ),
                            );
                          }).toList(),
                        ),
                      ),
                    ],
                  ),
                // Show uploaded previews (download URLs) after upload
                if (_previewUrls.isNotEmpty)
                  Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      const SizedBox(height: 12),
                      const Text('Uploaded Photos:', style: TextStyle(fontWeight: FontWeight.w600)),
                      const SizedBox(height: 8),
                      SizedBox(
                        height: 120,
                        child: ListView(
                          scrollDirection: Axis.horizontal,
                          children: _previewUrls.map((url) {
                            return Padding(
                              padding: const EdgeInsets.only(right: 8.0),
                              child: Container(
                                width: 120,
                                height: 120,
                                decoration: BoxDecoration(
                                  border: Border.all(color: Colors.grey.shade300),
                                  borderRadius: BorderRadius.circular(6),
                                ),
                                child: ClipRRect(
                                  borderRadius: BorderRadius.circular(6),
                                  child: CachedNetworkImage(
                                    imageUrl: url,
                                    fit: BoxFit.cover,
                                    placeholder: (context, url) => const Center(child: CircularProgressIndicator()),
                                    errorWidget: (context, url, error) => const Center(child: Icon(Icons.broken_image)),
                                  ),
                                ),
                              ),
                            );
                          }).toList(),
                        ),
                      ),
                    ],
                  ),
              ],
            ),
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('Cancel'),
          ),
          ElevatedButton(
            onPressed: () => _saveNewVehicle(
              registrationController.text,
              licensePlateController.text,
              makeController.text,
              modelController.text,
            ),
            style: ElevatedButton.styleFrom(
              backgroundColor: Colors.green,
            ),
            child: const Text('Add Vehicle'),
          ),
        ],
      ),
    );
  }

  void _showEditVehicleDialog(Vehicle vehicle) {
    final registrationController = TextEditingController(text: vehicle.registration);
    final licensePlateController = TextEditingController(text: vehicle.licensePlate);
    final makeController = TextEditingController(text: vehicle.make);
    final modelController = TextEditingController(text: vehicle.model);

    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: Text('Edit Vehicle - ${vehicle.registration}'),
        content: SizedBox(
          width: 600,
          height: 600,
          child: SingleChildScrollView(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                TextField(
                  controller: registrationController,
                  decoration: const InputDecoration(
                    labelText: 'Registration Number *',
                    border: OutlineInputBorder(),
                    hintText: 'e.g., V-001',
                  ),
                ),
                const SizedBox(height: 12),
                TextField(
                  controller: licensePlateController,
                  decoration: const InputDecoration(
                    labelText: 'License Plate',
                    border: OutlineInputBorder(),
                    hintText: 'e.g., ABC 123',
                  ),
                ),
                const SizedBox(height: 12),
                TextField(
                  controller: makeController,
                  decoration: const InputDecoration(
                    labelText: 'Make',
                    border: OutlineInputBorder(),
                    hintText: 'e.g., Toyota',
                  ),
                ),
                const SizedBox(height: 12),
                TextField(
                  controller: modelController,
                  decoration: const InputDecoration(
                    labelText: 'Model',
                    border: OutlineInputBorder(),
                    hintText: 'e.g., Hiace',
                  ),
                ),
                const SizedBox(height: 16),
                // Photos picker (limit to 2 images, show existing)
                Text(
                  'Vehicle Photos (Optional, max 2${vehicle.documents != null ? ' - Currently has ${vehicle.documents!.length}' : ''})',
                  style: TextStyle(fontWeight: FontWeight.bold),
                ),
                const SizedBox(height: 8),
                Row(
                  children: [
                    ElevatedButton.icon(
                      onPressed: _isUploading ? null : (vehicle.documents != null && vehicle.documents!.length >= 2) ? null : _pickFiles,
                      icon: _isUploading ? const SizedBox(width: 16, height: 16, child: CircularProgressIndicator(strokeWidth: 2, color: Colors.white)) : const Icon(Icons.photo),
                      label: Text(_selectedFiles.isEmpty ? 'Add Photos' : 'Change Photos'),
                    ),
                    const SizedBox(width: 12),
                    if (_selectedFiles.isNotEmpty) ...[
                      ElevatedButton.icon(
                        onPressed: _isUploading ? null : _uploadSelectedFiles,
                        icon: _isUploading
                            ? const SizedBox(
                                width: 16,
                                height: 16,
                                child: CircularProgressIndicator(strokeWidth: 2, color: Colors.white),
                              )
                            : const Icon(Icons.upload),
                        label: _isUploading ? const Text('Uploading...') : const Text('Upload Photos'),
                        style: ElevatedButton.styleFrom(
                          backgroundColor: Colors.blue,
                        ),
                      ),
                      const SizedBox(width: 12),
                    ],
                    if (_selectedFiles.isNotEmpty)
                      Text('${_selectedFiles.length}/2 selected')
                  ],
                ),
                const SizedBox(height: 8),
                // Show existing photos
                if (vehicle.documents != null && vehicle.documents!.isNotEmpty)
                  Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      const Text('Existing Photos:', style: TextStyle(fontWeight: FontWeight.w500)),
                      const SizedBox(height: 8),
                      SizedBox(
                        height: 100,
                        child: ListView(
                          scrollDirection: Axis.horizontal,
                          children: vehicle.documents!.map((docUrl) {
                            return Padding(
                              padding: const EdgeInsets.only(right: 8.0),
                              child: Container(
                                width: 100,
                                height: 100,
                                decoration: BoxDecoration(
                                  border: Border.all(color: Colors.grey.shade300),
                                  borderRadius: BorderRadius.circular(6),
                                ),
                                child: ClipRRect(
                                  borderRadius: BorderRadius.circular(6),
                                  child: CachedNetworkImage(
                                    imageUrl: docUrl,
                                    fit: BoxFit.cover,
                                    placeholder: (context, url) => const Center(child: CircularProgressIndicator()),
                                    errorWidget: (context, url, error) => const Center(child: Icon(Icons.error)),
                                  ),
                                ),
                              ),
                            );
                          }).toList(),
                        ),
                      ),
                      const SizedBox(height: 8),
                    ],
                  ),
                if (_selectedFiles.isNotEmpty)
                  Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      const Text('New Photos to Add:', style: TextStyle(fontWeight: FontWeight.w500)),
                      const SizedBox(height: 8),
                      SizedBox(
                        height: 120,
                        child: ListView(
                          scrollDirection: Axis.horizontal,
                          children: _selectedFiles.map((pf) {
                            final isImage = pf.name.toLowerCase().endsWith('.png') || pf.name.toLowerCase().endsWith('.jpg') || pf.name.toLowerCase().endsWith('.jpeg') || pf.name.toLowerCase().endsWith('.webp') || pf.name.toLowerCase().endsWith('.gif');
                            return Padding(
                              padding: const EdgeInsets.only(right: 8.0),
                              child: Stack(
                                children: [
                                  Container(
                                    width: 120,
                                    height: 120,
                                    decoration: BoxDecoration(
                                      border: Border.all(color: Colors.grey.shade300),
                                      borderRadius: BorderRadius.circular(6),
                                    ),
                                    child: ClipRRect(
                                      borderRadius: BorderRadius.circular(6),
                                      child: isImage
                                          ? (pf.bytes != null
                                              ? Image.memory(pf.bytes!, fit: BoxFit.cover)
                                              : (pf.path != null ? Image.file(File(pf.path!), fit: BoxFit.cover) : const SizedBox.shrink()))
                                          : Center(child: Text(pf.name, textAlign: TextAlign.center, overflow: TextOverflow.ellipsis)),
                                    ),
                                  ),
                                  Positioned(
                                    right: 0,
                                    top: 0,
                                    child: InkWell(
                                      onTap: () {
                                        setState(() {
                                          _selectedFiles.remove(pf);
                                        });
                                      },
                                      child: Container(
                                        decoration: BoxDecoration(color: Colors.black54, borderRadius: BorderRadius.circular(12)),
                                        padding: const EdgeInsets.all(4),
                                        child: const Icon(Icons.close, color: Colors.white, size: 16),
                                      ),
                                    ),
                                  ),
                                ],
                              ),
                            );
                          }).toList(),
                        ),
                      ),
                      const SizedBox(height: 8),
                      // list view of names and per-file status
                      Column(
                        children: _selectedFiles.map((pf) {
                          final id = '${pf.name}_${pf.size}';
                          final prog = _uploadProgress[id] ?? 0.0;
                          final err = _uploadError[id];
                          final url = _uploadedUrl[id];
                          return ListTile(
                            contentPadding: EdgeInsets.zero,
                            title: Text(pf.name),
                            subtitle: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Text('${pf.size} bytes'),
                                const SizedBox(height: 6),
                                if (err != null)
                                  Row(
                                    children: [
                                      Expanded(child: Text('Error: $err', style: TextStyle(color: AppTheme.errorColor))),
                                      TextButton(
                                        onPressed: () => _retryUpload(pf, vehicleId: vehicle.id),
                                        child: const Text('Retry'),
                                      ),
                                    ],
                                  ),
                                if (err == null && prog > 0 && prog < 1)
                                  LinearProgressIndicator(value: prog),
                                if (url != null)
                                  Row(
                                    children: [
                                      const Icon(Icons.check_circle, color: Colors.green, size: 16),
                                      const SizedBox(width: 6),
                                      Expanded(child: Text(url, maxLines: 1, overflow: TextOverflow.ellipsis)),
                                    ],
                                  ),
                              ],
                            ),
                            trailing: IconButton(
                              icon: const Icon(Icons.delete_outline),
                              onPressed: () {
                                setState(() {
                                  _selectedFiles.remove(pf);
                                });
                              },
                            ),
                          );
                        }).toList(),
                      ),
                    ],
                  ),
              ],
            ),
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('Cancel'),
          ),
          ElevatedButton(
            onPressed: () => _saveEditedVehicle(
              vehicle,
              registrationController.text,
              licensePlateController.text,
              makeController.text,
              modelController.text,
            ),
            style: ElevatedButton.styleFrom(
              backgroundColor: Colors.blue,
            ),
            child: const Text('Update Vehicle'),
          ),
        ],
      ),
    );
  }

  Future<void> _saveNewVehicle(
    String registration,
    String licensePlate,
    String make,
    String model,
  ) async {
    try {
      if (registration.isEmpty) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('Registration number is required'),
            backgroundColor: Colors.red,
          ),
        );
        return;
      }

      final authProvider = context.read<AuthProvider>();
      final companyId = authProvider.currentUser?.companyId;
      if (companyId == null) throw Exception('No company ID');

      final newVehicle = Vehicle(
        id: '', // Will be set by Firestore
        companyId: companyId,
        registration: registration.trim(),
        licensePlate: licensePlate.isNotEmpty ? licensePlate.trim() : null,
        make: make.isNotEmpty ? make.trim() : null,
        model: model.isNotEmpty ? model.trim() : null,
        status: VehicleStatus.active,
        createdAt: DateTime.now(),
        totalDeliveries: 0,
      );

      final docRef = await FirebaseFirestore.instance
          .collection('companies')
          .doc(companyId)
          .collection('vehicles')
          .add(newVehicle.toFirestore());

      // Upload selected photos (max 2) and update vehicle with document URLs
      if (_selectedFiles.isNotEmpty) {
        final List<String> uploadedUrls = [];
        final docService = _getDocumentService();
        final filesToUpload = _selectedFiles.take(2).toList();

        for (final pf in filesToUpload) {
          final id = '${pf.name}_${pf.size}';
          // Check if already uploaded
          final existingUrl = _uploadedUrl[id];
          if (existingUrl != null) {
            uploadedUrls.add(existingUrl);
            continue;
          }

          try {
            final url = await docService.uploadFile(
              companyId: companyId,
              vehicleId: docRef.id,
              file: pf,
              onProgress: (p) {
                setState(() {
                  _uploadProgress[id] = p;
                });
              },
            );
            uploadedUrls.add(url);
            setState(() {
              _uploadedUrl[id] = url;
            });
          } catch (e) {
            setState(() {
              _uploadError[id] = e.toString();
            });
            // continue with next file
          }
        }

        if (uploadedUrls.isNotEmpty) {
          await docRef.update({'documents': uploadedUrls});
        }
      }

      if (mounted) {
        Navigator.pop(context);
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Vehicle $registration added successfully'),
            backgroundColor: Colors.green,
          ),
        );
        _selectedFiles.clear();
        setState(() {});
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Error adding vehicle: $e'),
            backgroundColor: Colors.red,
          ),
        );
      }
    }
  }

  Future<void> _saveEditedVehicle(
    Vehicle vehicle,
    String registration,
    String licensePlate,
    String make,
    String model,
  ) async {
    try {
      if (registration.isEmpty) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('Registration number is required'),
            backgroundColor: Colors.red,
          ),
        );
        return;
      }

      final authProvider = context.read<AuthProvider>();
      final companyId = authProvider.currentUser?.companyId;
      if (companyId == null) throw Exception('No company ID');

      final updateData = {
        'registration': registration.trim(),
        'make': make.isNotEmpty ? make.trim() : null,
        'model': model.isNotEmpty ? model.trim() : null,
        'licensePlate': licensePlate.isNotEmpty ? licensePlate.trim() : null,
        'lastUsedAt': vehicle.lastUsedAt != null
            ? Timestamp.fromDate(vehicle.lastUsedAt!)
            : null,
      };

      await FirebaseFirestore.instance
          .collection('companies')
          .doc(companyId)
          .collection('vehicles')
          .doc(vehicle.id)
          .update(updateData);

      // If there are new selected photos, upload and append to existing documents
      if (_selectedFiles.isNotEmpty) {
        final existing = vehicle.documents ?? [];
        final List<String> uploadedUrls = [];
        final docService = _getDocumentService();
        final filesToUpload = _selectedFiles.take(2 - existing.length).toList();

        for (final pf in filesToUpload) {
          final id = '${pf.name}_${pf.size}';
          // Check if already uploaded
          final existingUrl = _uploadedUrl[id];
          if (existingUrl != null) {
            uploadedUrls.add(existingUrl);
            continue;
          }

          try {
            final url = await docService.uploadFile(
              companyId: companyId,
              vehicleId: vehicle.id,
              file: pf,
              onProgress: (p) {
                setState(() {
                  _uploadProgress[id] = p;
                });
              },
            );
            uploadedUrls.add(url);
            setState(() {
              _uploadedUrl[id] = url;
            });
          } catch (e) {
            setState(() {
              _uploadError[id] = e.toString();
            });
          }
        }

        if (uploadedUrls.isNotEmpty) {
          final merged = [...existing, ...uploadedUrls];
          await FirebaseFirestore.instance
              .collection('companies')
              .doc(companyId)
              .collection('vehicles')
              .doc(vehicle.id)
              .update({'documents': merged});
        }
      }

      if (mounted) {
        Navigator.pop(context);
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Vehicle $registration updated successfully'),
            backgroundColor: Colors.green,
          ),
        );
        _selectedFiles.clear();
        setState(() {});
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Error updating vehicle: $e'),
            backgroundColor: Colors.red,
          ),
        );
      }
    }
  }

  void _bulkActivateVehicles() {}
  void _bulkMaintenanceVehicles() {}
  void _bulkDeactivateVehicles() {}
}


